{
  "name": "orc-document-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --legacy-watch --watch server/src --ext js,json server/src/index.js",
    "dev:client": "vite --config client/vite.config.js --host 0.0.0.0",
    "start": "node server/src/index.js",
    "build": "vite build --config client/vite.config.js",
    "db:check": "node server/src/db/check.js",
    "seed": "node server/src/db/seed.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.15",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.29",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "vite": "^6.0.3"
  }
}
