# App
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret
MAX_UPLOAD_MB=25
BILLING_RATE_PER_APPLICATION=500

# MySQL. Railway can provide MYSQL_URL through a reference to its MySQL service.
MYSQL_URL=mysql://root:orc-local-root-password@127.0.0.1:3306/orc_document_automation
# Alternatively omit MYSQL_URL and set MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD, and MYSQLDATABASE individually.
MYSQL_SSL=false
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_MS=3000

# Persistent uploaded/generated file storage
UPLOADS_DIR=server/uploads

# Optional client setting. Leave blank when the UI and API use the same domain.
VITE_API_URL=

# Optional PowerMail integration
POWERMAIL_BASE_URL=https://powermail.beestack.co.za/api
POWERMAIL_API_KEY=
POWERMAIL_FROM_EMAIL=
POWERMAIL_TEMPLATE_KEY=

# Optional OpenAI document extraction
OPENAI_API_KEY=
AI_EXTRACTION_MODEL=gpt-5-nano
